SHAREGUARD_EXECUTION_MODE=LOCAL
SHAREGUARD_EXECUTION_LOCAL_USERNAME=admin
SHAREGUARD_EXECUTION_LOCAL_PASSWORD=
SHAREGUARD_EXECUTION_COMMAND_TIMEOUT=30s
SHAREGUARD_EXECUTION_HELPER_SOCKET=/run/shareguard/helper.sock
SHAREGUARD_HELPER_SOCKET=/run/shareguard/helper.sock
SHAREGUARD_HELPER_TIMEOUT=30
SHAREGUARD_ALLOWED_ROOTS=/mnt:/media:/srv:/data:/home
SHAREGUARD_CONFIG_PATH=/etc/samba/smb.conf
SHAREGUARD_BACKUP_DIR=/etc/samba/backups
SHAREGUARD_LOG_PATH=/var/log/samba/log.smbd
SHAREGUARD_TEMP_CONFIG=/tmp/smb.conf.tmp
SHAREGUARD_KRB5_CONFIG=/etc/krb5.conf
SHAREGUARD_GROUP_PREFIX=smb_
SAMBA_SECURITY_ALLOWED_ROOTS=/mnt,/media,/srv,/data,/home
SAMBA_PATHS_CONFIG=/etc/samba/smb.conf
SAMBA_PATHS_BACKUPS=/etc/samba/backups
SAMBA_PATHS_LOG=/var/log/samba/log.smbd
SAMBA_GROUP_PREFIX=smb_
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080
