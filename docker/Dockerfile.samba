FROM ubuntu:22.04

# Отключаем интерактивные запросы apt
ENV DEBIAN_FRONTEND=noninteractive

# Устанавливаем SSH сервер, Samba и утилиты
RUN apt-get update && apt-get install -y \
    openssh-server \
    sudo \
    smbclient \
    vim \
    && rm -rf /var/lib/apt/lists/*

# Настраиваем SSH для возможности логина пользователя и root
RUN mkdir /var/run/sshd && \
    sed -i 's/#PermitRootLogin prohibit-password/PermitRootLogin yes/' /etc/ssh/sshd_config && \
    sed -i 's/#PasswordAuthentication yes/PasswordAuthentication yes/' /etc/ssh/sshd_config

# Копируем конфигурационные файлы и скрипты в образ
COPY docker/scripts/systemctl-stub.sh /usr/bin/systemctl
COPY docker/scripts/entrypoint.sh /entrypoint.sh
COPY docker/config/smb-base.conf /tmp/smb-base.conf
COPY scripts/setup-samba-server.sh /setup-samba-server.sh
COPY docker/scripts/setup-test-data.sh /setup-test-data.sh

# Настраиваем права доступа для скриптов
RUN chmod +x /usr/bin/systemctl /entrypoint.sh /setup-samba-server.sh /setup-test-data.sh

# Запускаем скрипт начальной установки Samba-пользователя (admin) в неинтерактивном режиме
ENV AUTO_ADMIN_USER=admin
ENV AUTO_ADMIN_PASS=admin
RUN /setup-samba-server.sh

# Генерируем тестовые данные для песочницы разработчиков
RUN /setup-test-data.sh

# Подготавливаем структуру директорий и базовую конфигурацию Samba
RUN mkdir -p /srv/samba/public && \
    chown -R admin:admin /srv/samba/public && \
    chmod -R 0755 /srv/samba/public && \
    mv /etc/samba/smb.conf /etc/samba/smb.conf.bak && \
    cp /tmp/smb-base.conf /etc/samba/smb.conf

# Открываем порты SSH (22) и Samba (139, 445)
EXPOSE 22 139 445

CMD ["/entrypoint.sh"]
