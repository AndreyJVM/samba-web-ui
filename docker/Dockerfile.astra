# ==========================================================================
# Stage 1: Build Application JAR (Maven)
# Built on JDK image (Debian Jammy) - paxctl is NOT needed here
# because this stage is not included in the final image.
# ==========================================================================
FROM eclipse-temurin:21-jdk-jammy AS build
WORKDIR /app

# Copy Maven wrapper & project config
COPY mvnw ./
COPY .mvn .mvn
COPY pom.xml ./
RUN chmod +x mvnw

# Copy source code and pre-built frontend assets
COPY src ./src
COPY frontend ./frontend

# Build argument to skip tests (default: false)
ARG SKIP_TESTS=false

# Build the JAR
RUN --mount=type=cache,target=/root/.m2 \
    if [ "$SKIP_TESTS" = "true" ]; then \
        echo ">>> Building WITHOUT tests (-DskipTests)" && \
        ./mvnw package -DskipTests -Dmaven.test.skip=true -Dfrontend.skip=true; \
    else \
        echo ">>> Building WITH tests" && \
        ./mvnw package -Dfrontend.skip=true; \
    fi


# ==========================================================================
# Stage 2: Production Container (Astra Linux / Parsec compatible)
# --------------------------------------------------------------------------
# ==========================================================================
FROM eclipse-temurin:21-jre-alpine AS production
WORKDIR /app

RUN apk add --no-cache paxctl \
    && JAVA_BIN="$(readlink -f "$(command -v java)")" \
    && paxctl -Cm "$JAVA_BIN" \
    && paxctl -v "$JAVA_BIN" \
    && apk del paxctl

# --------------------------------------------------------------------------
# Copy compiled JAR from build stage
# --------------------------------------------------------------------------
COPY --from=build /app/target/*.jar /app/app.jar

# --------------------------------------------------------------------------
# MPROTECT is disabled only for the JVM in this Astra image to allow JIT.
# This relaxes memory execution protection for the Java process.
# The standard Docker image is unaffected by this change.
# --------------------------------------------------------------------------
EXPOSE 8080

ENTRYPOINT ["java", "-jar", "/app/app.jar"]
