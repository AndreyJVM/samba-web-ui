# Experimental runtime variant; compatibility requires testing on Astra itself.
FROM eclipse-temurin:21-jre-alpine AS production
WORKDIR /app

# Preserve the existing JVM-specific MPROTECT relaxation. This is not proof of
# compatibility with Astra/Parsec and must not be applied to the standard image.
RUN apk add --no-cache paxctl \
    && JAVA_BIN="$(readlink -f "$(command -v java)")" \
    && paxctl -c "$JAVA_BIN" \
    && paxctl -m "$JAVA_BIN" \
    && paxctl -v "$JAVA_BIN" \
    && apk del paxctl

ARG JAR_FILE=target/*.jar
COPY --chmod=0644 ${JAR_FILE} /app/app.jar
USER 10001:10001
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
